{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "city-scramble",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LOBBY", "class_name": "GameLobby" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameLobby"] }],
  "kv_namespaces": [
    { "binding": "OSM_CACHE", "id": "cffb9bc29ddc44e2b4f59833e6ddc3ac" }
  ]
}
